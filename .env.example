DISCORD_TOKEN=your_discord_bot_token

# Limbus Company Steam app id.
STEAM_APP_ID=1973530

# Default Steam language code. Servers can override this with /서버설정.
# Supported: koreana, english, japanese
STEAM_LANGUAGE=koreana
STEAM_COUNTRY=KR

# Optional: override the generated Steam news hub URL.
# STEAM_NEWS_URL=https://store.steampowered.com/news/app/1973530?l=koreana&cc=KR

# Slash commands are synced globally so user-installed app commands work in servers and DMs.
COMMAND_SYNC_MODE=global

# Optional: stale guild-scoped commands in this server are cleared on startup.
# COMMAND_GUILD_ID=123456789012345678

DATABASE_PATH=limpi.sqlite3
LIMPI_LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=300
# Default sync count.
MAX_POSTS_PER_POLL=10
ANNOUNCE_EXISTING_ON_FIRST_RUN=false

# KST high-frequency sync window for Steam news.
# X/Twitter posts are checked 24 hours a day every 20 seconds,
# and every 10 seconds during the high-frequency window below.
# Default: every day 18:00-20:00 KST, every 60 seconds.
HIGH_FREQUENCY_POLL_DAYS=mon,tue,wed,thu,fri,sat,sun
HIGH_FREQUENCY_START_HOUR=18
HIGH_FREQUENCY_END_HOUR=20
HIGH_FREQUENCY_POLL_INTERVAL_SECONDS=60

# Optional: official X/Twitter post commands and auto delivery.
# Account defaults to https://x.com/LimbusCompany_B
X_ACCOUNT_USERNAME=LimbusCompany_B

# X/Twitter cookie auth. Required for timeline/reply access.
# How to get values:
#   1. Log into x.com in your browser
#   2. F12 → Application → Cookies → https://x.com
#   3. Copy auth_token and ct0 values
X_AUTH_TOKEN=your_auth_token_cookie
X_CT0=your_ct0_cookie

# Optional: override X GraphQL query ids when X changes them.
# X_QID_USER_BY_SCREEN_NAME=NimuplG1OB7Fd2btCLdBOw
# X_QID_USER_TWEETS_AND_REPLIES=D5eKzDa5ZoJuC1TCeAXbWA
