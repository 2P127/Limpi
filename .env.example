DISCORD_TOKEN=디스코드_봇_토큰

# 림버스 컴퍼니 Steam 앱 ID.
STEAM_APP_ID=1973530

# 기본 Steam 언어 코드. 서버별로 /서버설정으로 덮어쓸 수 있음.
# 지원: koreana, english, japanese
STEAM_LANGUAGE=koreana
STEAM_COUNTRY=KR

# 선택: 자동 생성된 Steam 뉴스 허브 URL을 직접 지정.
# STEAM_NEWS_URL=https://store.steampowered.com/news/app/1973530?l=koreana&cc=KR

# 슬래시 명령어는 전역으로 동기화되어 서버 및 DM에서 유저 설치 앱 명령어가 작동함.
COMMAND_SYNC_MODE=global

# 선택: 시작 시 이 서버의 오래된 길드 명령어를 초기화.
# COMMAND_GUILD_ID=123456789012345678

DATABASE_PATH=limpi.sqlite3
LIMPI_LOG_LEVEL=INFO
POLL_INTERVAL_SECONDS=30
# 기본 동기화 개수.
MAX_POSTS_PER_POLL=10
ANNOUNCE_EXISTING_ON_FIRST_RUN=false

# Steam 뉴스 KST 고빈도 동기화 시간대.
# 기본값: 매일 00:00~24:00 KST, 10초 간격.
HIGH_FREQUENCY_POLL_DAYS=mon,tue,wed,thu,fri,sat,sun
HIGH_FREQUENCY_START_HOUR=0
HIGH_FREQUENCY_END_HOUR=24
HIGH_FREQUENCY_POLL_INTERVAL_SECONDS=10

# 선택: X/트위터 게시물 명령어 및 자동 전송.
# 기본 계정: https://x.com/LimbusCompany_B
X_ACCOUNT_USERNAME=LimbusCompany_B

# X/트위터 쿠키 인증. 타임라인/답글 접근에 필수.
# 값 가져오는 방법:
#   1. 브라우저에서 x.com 로그인
#   2. F12 → Application → Cookies → https://x.com
#   3. auth_token 과 ct0 값 복사
X_AUTH_TOKEN=인증_토큰_쿠키
X_CT0=ct0_쿠키

# 선택: X가 GraphQL 쿼리 ID를 변경했을 때 직접 지정.
# X_QID_USER_BY_SCREEN_NAME=NimuplG1OB7Fd2btCLdBOw
# X_QID_USER_TWEETS_AND_REPLIES=D5eKzDa5ZoJuC1TCeAXbWA

# X(트위터) 추적 시간대(KST). HH:MM-HH:MM 쉼표 구분. 끝<=시작이면 자정 넘김(wrap).
# 기본: 00:00-01:00, 10:00-16:00, 17:00-01:00 (24시간 폴링 아님).
# TWITTER_TRACKING_WINDOWS_KST=00:00-01:00,10:00-16:00,17:00-01:00
# X 폴링 간격(초). 기본 30. 레이트리밋 여유 확인 후에만 MIN까지 낮추세요.
# TWITTER_POLL_INTERVAL_SECONDS=30
# X 폴링 최소 간격(초). 이 값 아래로는 내려가지 않음. 기본 20.
# TWITTER_MIN_POLL_INTERVAL_SECONDS=20
# 429 최초 backoff(초). 연속 발생 시 multiplier로 증가. 기본 60.
# TWITTER_RATE_LIMIT_BACKOFF_SECONDS=60
# 연속 429 backoff 증가 배수. 기본 2.0.
# TWITTER_429_BACKOFF_MULTIPLIER=2.0
# backoff 상한(초). 기본 600(10분).
# TWITTER_MAX_BACKOFF_SECONDS=600
# X 자동전송 나이 게이트(초). 0=비활성(기본). 윈도우 갭보다 짧으면 정상 글도 버려질 수 있으니 관측 후 설정.
# TWITTER_ANNOUNCE_MAX_AGE_SECONDS=0
# X 관측 전용 프로브(테스트 봇에서만). 1이면 전송/DB 변경 없이 JSONL 관측만.
# X_NEWS_PROBE=0
