DISCORD_TOKEN=your_discord_bot_token

# Limbus Company Steam app id.
STEAM_APP_ID=1973530

# Default Steam language code. Servers can override this with /림피설정.
# Supported: koreana, english, japanese
STEAM_LANGUAGE=koreana
STEAM_COUNTRY=KR

# Optional: override the generated Steam news hub URL.
# STEAM_NEWS_URL=https://store.steampowered.com/news/app/1973530?l=koreana&cc=KR

# Slash command sync mode.
# global: recommended for a public app; commands work in every installed server.
# guild: faster for testing; commands are registered only as server commands.
COMMAND_SYNC_MODE=global

# Optional for COMMAND_SYNC_MODE=guild: sync slash commands to one server id only.
# COMMAND_GUILD_ID=123456789012345678

DATABASE_PATH=limpi.sqlite3
POLL_INTERVAL_SECONDS=300
# Default sync count. Servers can override this with /림피설정 가져올개수.
MAX_POSTS_PER_POLL=10
ANNOUNCE_EXISTING_ON_FIRST_RUN=false

# KST high-frequency sync window.
# Default: Monday, Tuesday, Thursday 18:00-20:00 KST, every 60 seconds.
HIGH_FREQUENCY_POLL_DAYS=mon,tue,thu
HIGH_FREQUENCY_START_HOUR=18
HIGH_FREQUENCY_END_HOUR=20
HIGH_FREQUENCY_POLL_INTERVAL_SECONDS=60
